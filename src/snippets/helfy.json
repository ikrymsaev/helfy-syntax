{
  "Helfy @if": {
    "prefix": ["@if", "hif"],
    "body": [
      "@if (${1:condition}) {",
      "    ${0}",
      "}"
    ],
    "description": "Helfy @if block"
  },
  "Helfy @if / @else": {
    "prefix": ["@ifelse", "hifelse"],
    "body": [
      "@if (${1:condition}) {",
      "    ${2}",
      "} @else {",
      "    ${0}",
      "}"
    ],
    "description": "Helfy @if / @else block"
  },
  "Helfy @if / @elseif / @else": {
    "prefix": ["@ifelseif", "hifelseif"],
    "body": [
      "@if (${1:condition}) {",
      "    ${2}",
      "} @elseif (${3:condition}) {",
      "    ${4}",
      "} @else {",
      "    ${0}",
      "}"
    ],
    "description": "Helfy @if / @elseif / @else chain"
  },
  "Helfy @elseif": {
    "prefix": ["@elseif", "helseif"],
    "body": [
      "@elseif (${1:condition}) {",
      "    ${0}",
      "}"
    ],
    "description": "Helfy @elseif block"
  },
  "Helfy @else": {
    "prefix": ["@else", "helse"],
    "body": [
      "@else {",
      "    ${0}",
      "}"
    ],
    "description": "Helfy @else block"
  },
  "Helfy @for": {
    "prefix": ["@for", "hfor"],
    "body": [
      "@for (${1:item} of ${2:this.items}; track ${3:$1}) {",
      "    ${0}",
      "}"
    ],
    "description": "Helfy @for loop with track"
  },
  "Helfy @for with index": {
    "prefix": ["@fori", "hfori"],
    "body": [
      "@for (${1:item}, ${2:i} of ${3:this.items}; track ${4:$1}) {",
      "    ${0}",
      "}"
    ],
    "description": "Helfy @for loop with index and track"
  },
  "Helfy @for with @empty": {
    "prefix": ["@forempty", "hforempty"],
    "body": [
      "@for (${1:item} of ${2:this.items}; track ${3:$1}) {",
      "    ${4}",
      "} @empty {",
      "    ${0}",
      "}"
    ],
    "description": "Helfy @for loop with @empty fallback"
  },
  "Helfy slot provider with fallback": {
    "prefix": ["@slotp", "@slot:provider"],
    "body": [
      "@slot:${1:slotName}({ ${2:props} }) fallback {",
      "    ${0}",
      "}"
    ],
    "description": "Helfy slot provider with optional fallback body"
  },
  "Helfy slot consumer override": {
    "prefix": ["@slotc", "@slot:consumer"],
    "body": [
      "@slot.${1:slotName}({ ${2:ctx} }) {",
      "    ${0}",
      "}"
    ],
    "description": "Helfy slot override in consumer JSX"
  },
  "Helfy @ref": {
    "prefix": ["@ref", "href"],
    "body": ["@ref(this.${1:fieldName})"],
    "description": "Helfy @ref - bind to DOM or component instance"
  },
  "Helfy @bind": {
    "prefix": ["@bind", "hbind"],
    "body": ["@bind(this.${1:fieldName})"],
    "description": "Helfy @bind - two-way binding to @state field (DOM)"
  },
  "Helfy @bind:value": {
    "prefix": ["@bind:value", "hbindvalue"],
    "body": ["@bind:value(this.${1:fieldName})"],
    "description": "Helfy @bind:value - two-way binding on component (same syntax as @ref)"
  },
  "Helfy @field": {
    "prefix": ["@field", "hfield"],
    "body": ["@field(this.form.${1:fieldName})"],
    "description": "Helfy @field - FieldState binding: value + onblur + error class + aria"
  }
}
